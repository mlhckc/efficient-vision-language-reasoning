      "id": "G-R3-1",
      "statement": "the spent-grant refusal did not survive loss of terminal proof: it was keyed only on the whole-matrix state being AUTHORIZED_COMPLETE",
      "trigger": "one untracked local scientific binary, a per-row NPZ or a checkpoint, goes missing or fails its hash, so the strict whole-matrix proof correctly degrades to AUTHORIZED_INCOMPLETE",
      "consequence_before_repair": "an already-completed cell became AUTHORISED at the entry gate and authorize_cell_execution minted a signed optimizer permit for it; run.core_cell still refused later on the already-exists preflight, so no scientific computation could start, but the registered fail-closed grant semantics were violated",
      "independently_reproduced_before_repair": true,
      "reproduction": {
        "lifecycle_state": "AUTHORIZED_INCOMPLETE",
        "published_cell_records": 12,
        "charged_core_cells": 12,
        "grant_valid": true,
        "assert_core_entry_authorized": "AUTHORISED (returned a grant)",
        "authorize_cell_execution": "AUTHORISED (minted a CellExecutionPermit)",
        "run_core_cell": "refused only on the unrelated already-exists preflight"
      }
    },
    "repair": {
      "new_helper": "e10_common.cell_previously_completed",
      "indicators": [
        "a published result record for that exact cell",
        "a completed charge for that exact cell in the shared ledger"
      ],
      "either_indicator_alone_refuses": true,
      "independent_of_whole_matrix_state": true,
      "full_matrix_spent_refusal_retained": true,
      "blanket_incomplete_refusal_introduced": false,
      "semantics": {
        "authorised + incomplete + cell never run": "may execute if all other guards pass",
        "authorised + incomplete + requested cell previously completed": "REFUSE, immutable",
        "authorised + complete": "REFUSE all further execution, grant operationally SPENT",
        "unauthorised cell": "REFUSE"
      },
      "accounting_exception": {
        "caller": "e10_common.charge_core_cell_hours",
        "parameter": "purpose=\"accounting\"",
        "why": "accounting runs AFTER a cell publishes its result, so the per-cell guard would otherwise refuse the charge of the cell that legitimately just finished and break the original execution lifecycle",
