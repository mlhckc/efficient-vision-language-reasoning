        {
          "fact_id": "top100_coincidence",
          "fact": "The top-100 vocabulary has zero normalised collisions and zero strings changed by normalisation; raw and normalised row correctness therefore coincide for classifiers whose predictions and golds are top-100 strings.",
          "sources": [
            {
              "path": "results/experiments/e8a_question_encoder/g21_scorer_inventory.json",
              "location": "$.g21_scorer_inventory.top_100 and $.g21_scorer_inventory.raw_versus_normalized_consequence"
            }
          ]
        },
        {
          "fact_id": "denominators",
          "fact": "The distinct development denominators are 7,714 top-100 in-vocabulary rows, 9,823 top-1000 in-vocabulary rows, and 10,004 raw-distribution rows.",
