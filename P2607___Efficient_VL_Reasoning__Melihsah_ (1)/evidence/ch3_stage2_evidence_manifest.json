    {
      "id": "3.6",
      "title": "Frozen representations and feature extraction",
      "planned_later_prose_budget_words": 250,
      "supported_facts": [
        {
          "fact_id": "clip_global",
          "fact": "One frozen OpenCLIP ViT-B-32 model with laion2b_s34b_b79k weights serves both image and question towers, producing L2-normalised float32 512-dimensional global vectors; the two modalities share this pretrained space by construction.",
          "sources": [
            {
              "path": "docs/experiments/v2_01_embeddings.md",
              "location": "Method, paragraphs 1-2"
            },
            {
              "path": "CLAUDE.md",
              "location": "Locked scope, encoders"
            }
          ]
        },
        {
          "fact_id": "siglip_global_swap",
          "fact": "E2 replaces the global-path encoder with one frozen OpenCLIP ViT-B-16-SigLIP model using webli weights for both modalities under the v2_02 recipe; this does not replace the CLIP token stores.",
          "sources": [
            {
              "path": "docs/experiments/e2_siglip.md",
              "location": "Purpose and Method, paragraphs 1-3"
            },
            {
              "path": "artifacts/results_export/e2_siglip/preflight.json",
              "location": "$.e2_preflight.model, $.e2_preflight.pretrained and $.e2_preflight.versions"
            },
            {
              "path": "docs/experiments/v3_00_tokens.md",
              "location": "Purpose and Method"
            }
          ]
        },
        {
          "fact_id": "clip_token_stores",
          "fact": "The latent-reasoner store design uses frozen CLIP tokens: 50 projected visual tokens comprising CLS plus 49 patches, and packed projected question tokens; stored token values are unnormalised fp16.",
          "sources": [
            {
              "path": "docs/experiments/v3_00_tokens.md",
              "location": "Method, paragraphs 1-2"
            }
          ]
        },
        {
          "fact_id": "e8a_executed_capacity",
          "fact": "The executed E8A question-side family is A0p, A1 and A1r only; the SmolLM2 arms use the 135M family. No 360M E8A question-side arm was executed.",
          "sources": [
            {
              "path": "docs/experiments/e8a_core_135m.md",
              "location": "Purpose and Method, arms and eighteen-cell design"
            },
            {
              "path": "docs/experiments/pre_f1_unrun_arms_disposition.md",
              "location": "Results, execution audit and disposition table"
            }
          ]
        },
        {
          "fact_id": "e8a_projection_and_space_disclosure",
          "fact": "A1 and A1r project 576-dimensional SmolLM2-135M hidden states through one trainable Linear(576, 512) layer into the reasoner width. A learned common 512-dimensional width is not a naturally shared pretrained CLIP/SmolLM2 semantic space.",
          "sources": [
            {
              "path": "docs/experiments/e8a_core_135m.md",
              "location": "Purpose, arm definitions; Method, projection disclosure"
            },
            {
              "path": "CLAUDE.md",
              "location": "Locked scope, encoders"
            }
          ]
        },
