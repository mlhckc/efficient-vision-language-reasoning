        {
          "fact_id": "g21_normalised_exact",
          "fact": "The primary cross-system normalised metric is one pinned single-gold VQA-style normalised exact match, G21, applied to predictions and canonical gold strings.",
          "sources": [
            {
              "path": "results/experiments/e8a_question_encoder/e8a_135m_core_frozen_g21.json",
