  "subsections": [
    {
      "id": "3.4",
      "title": "Answer-space construction: top-100 and top-1000",
      "planned_later_prose_budget_words": 250,
      "supported_facts": [
        {
          "fact_id": "top100_construction",
          "fact": "The V2 answer space contains the 100 most frequent raw training-pool answers, ordered by descending frequency with alphabetical tie-breaking; development images contribute nothing to its construction.",
          "sources": [
            {
              "path": "docs/experiments/v2_00_protocol.md",
              "location": "The V2 partition, V2 vocabulary bullet"
            },
            {
              "path": "artifacts/v2_00_protocol/protocol_build_summary.json",
              "location": "$.vocabulary"
            }
          ]
        },
        {
          "fact_id": "top100_artifact",
          "fact": "The authorised non-data protocol-artifact copy of the V2 top-100 vocabulary is byte-pinned in this manifest.",
          "sources": [
            {
              "path": "artifacts/v2_00_protocol/answer_vocab_v2.json",
              "location": "complete JSON object"
            }
          ]
        },
        {
          "fact_id": "top1000_extension",
          "fact": "E3 extends the identical count-descending, lexicographic-tie-break rule to 1,000 answers using raw training-pool answers only.",
          "sources": [
            {
              "path": "docs/experiments/e3_vocab1000.md",
              "location": "Method, paragraphs 1-2"
            }
          ]
        },
        {
          "fact_id": "prefix_identity_gate",
          "fact": "The first 100 top-1000 entries, including their indices, were gated identical to the V2 top-100 vocabulary.",
          "sources": [
            {
              "path": "docs/experiments/e3_vocab1000.md",
              "location": "Method, paragraph 1"
            },
            {
              "path": "artifacts/results_export/e3_vocab1000/preflight.json",
              "location": "$.e3_preflight.prefix_gate"
            }
          ]
        },
        {
          "fact_id": "coverage_design_properties",
          "fact": "On the same 10,004-row raw development distribution, top-100 supports 7,714 rows (0.771092, approximately 0.7711) and top-1000 supports 9,823 rows (0.981907, approximately 0.9819). These are answer-space coverage properties, not model performance.",
          "sources": [
            {
              "path": "docs/experiments/v2_00_protocol.md",
              "location": "The V2 partition, dev.csv bullet"
            },
            {
              "path": "artifacts/results_export/e3_vocab1000/preflight.json",
              "location": "$.e3_preflight.dev_invocab and $.e3_preflight.dev_coverage_top1000"
            },
            {
              "path": "artifacts/results_export/e3_vocab1000/results.json",
              "location": "$.e3_vocab1000.build_summary.dev"
            }
          ]
        },
        {
          "fact_id": "v1_v2_label_guard",
          "fact": "V1 and V2 contain the same 100 answer strings but 11 answers have different indices, so their label maps are not interchangeable.",
          "sources": [
            {
              "path": "artifacts/v2_00_protocol/v1_v2_vocab_index_comparison.json",
              "location": "$.answer_sets_identical, $.answer_to_index_identical and $.n_answers_with_changed_index"
            }
          ]
        }
      ],
