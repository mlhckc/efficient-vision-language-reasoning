          "reason": "Highest authority for named E7b field validity and the bridge boundary."
        }
      },
      "supported_facts": [
        {
          "fact_id": "e7a_component_scope",
          "fact": "E7a timed stages in isolation. Its isolated encoder and head component measurements and retained parameter fields remain valid within that component scope.",
          "sources": [
            {
              "path": "results/closure/pre_f1_evidence_metadata_repair_20260814.json",
              "location": "$.e7a_locator.component_validity_unchanged and $.e7a_locator.withdrawal_guard"
            },
            {
              "path": "results/closure/efficiency_closure_table.json",
              "location": "row E7a::e7a_component_measurements"
            },
            {
              "path": "docs/experiments/e7a_efficiency.md",
              "location": "Status, lines 3-18"
            }
          ]
        },
        {
          "fact_id": "e7a_additive_withdrawal",
          "fact": "E7a's gpu_encoder_plus_head_ms, full_pipeline_ms and amortised_ms fields, and every frontier derived from those additive sums, are withdrawn from end-to-end use. They are not replaced by E7b values and must not be quoted for any purpose.",
          "sources": [
            {
              "path": "results/closure/pre_f1_evidence_metadata_repair_20260814.json",
              "location": "$.e7a_locator.withdrawal_guard.superseded_fields"
            },
            {
              "path": "docs/experiments/e7a_efficiency.md",
              "location": "Status, lines 3-18"
            }
          ]
        },
        {
          "fact_id": "e7b_serial_protocol",
          "fact": "E7b is the authoritative serial end-to-end protocol: batch size 1; one unbroken pass from image-file read and question input through answer decoding; three pass-major passes in pinned randomised order; a fresh subprocess per system and pass; 50 warm-up queries followed by 300 timed serial queries per pass; warm-run medians; historical node otter155.",
          "sources": [
            {
              "path": "docs/experiments/e7b_serial_efficiency.md",
              "location": "Purpose and Method, lines 31-64"
            },
            {
              "path": "results/experiments/e7b_serial_efficiency/e7b_results.json",
              "location": "$.e7b_analysis.fingerprint, $.e7b_analysis.pass_orders and $.e7b_analysis.systems[*]"
            }
          ]
        },
