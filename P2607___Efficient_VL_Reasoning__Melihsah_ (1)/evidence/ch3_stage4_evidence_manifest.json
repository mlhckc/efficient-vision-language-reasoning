    {
      "id": "3.10",
      "title": "Visual-reliance intervention design",
      "planned_later_prose_budget_words": 150,
      "interpretation_boundary_verbatim": "the intervention measures image reliance / sensitivity to visual information; it does not, by itself, establish compositional reasoning, causal visual reasoning, or general reasoning ability.",
      "supported_facts": [
        {
          "fact_id": "wrong_image_matched_logic",
          "fact": "The wrong-image condition holds the question and evaluation row fixed while replacing the associated image through one deterministic partner mapping, so normal and intervened correctness can be compared on matched questions.",
          "sources": [
            {
              "path": "results/experiments/e9_compact_vlm/frozen_protocol.json",
              "location": "$.derangement and $.conditions.deranged"
            },
            {
              "path": "docs/experiments/e9_compact_vlm.md",
              "location": "Image conditions, lines 69-74"
            }
          ]
        },
        {
          "fact_id": "canonical_imageid_derangement",
          "fact": "The operative intervention from the E8 programme onward is an imageId-level derangement: a permutation of sorted unique imageIds is rejection-sampled until it has no fixed point, then the same image-partner mapping is used for every matching question row.",
          "sources": [
            {
              "path": "results/experiments/e9_compact_vlm/frozen_protocol.json",
              "location": "$.derangement.construction, $.derangement.rng, $.derangement.self_pairs and $.derangement.intervention_kind"
            },
            {
              "path": "docs/experiments/v2_06_reliance.md",
              "location": "Self-pair disclosure and supersession note, lines 109-122"
            }
          ]
        },
        {
          "fact_id": "row_shuffle_supersession_reason",
          "fact": "The earlier row-level shuffle is superseded wherever the imageId derangement exists because it left 11 rows paired with their own imageId, approximately 0.14 per cent of rows. This is a method-supersession property, not an outcome claim.",
          "sources": [
            {
              "path": "docs/experiments/v2_06_reliance.md",
              "location": "Self-pair disclosure and supersession note, lines 109-122"
            }
          ]
        },
        {
          "fact_id": "e9_matched_partner_scope",
          "fact": "E9 uses the identical image-partner derangement as E8B, but not an identical feature-space intervention because preprocessing differs.",
          "sources": [
            {
              "path": "results/experiments/e9_compact_vlm/frozen_protocol.json",
              "location": "$.derangement.intervention_kind"
            },
            {
              "path": "docs/experiments/e9_compact_vlm.md",
              "location": "Image conditions, lines 69-74"
            }
          ]
        }
      ],
      "required_citation_keys_resolved": [],
      "bibliography_gaps": [],
      "excluded_claims": [
        "every visual-reliance magnitude",
        "every model comparison",
        "compositional-reasoning inference",
        "causal-visual-reasoning inference",
        "general-reasoning inference"
      ],
      "pending_source_verification": []
    },
    {
      "id": "3.11",
      "title": "Efficiency measurement protocol",
      "planned_later_prose_budget_words": 250,
      "efficiency_claim_boundary_verbatim": "efficiency claims are limited to measured warm-serial latency under the defined protocol, trainable parameter count, and canonically reported model size; no energy, power, carbon, monetary-cost or universal-deployment claim.",
      "controlling_records": {
        "e7a_locator_and_scope": {
          "path": "results/closure/pre_f1_evidence_metadata_repair_20260814.json",
          "location": "$.e7a_locator",
