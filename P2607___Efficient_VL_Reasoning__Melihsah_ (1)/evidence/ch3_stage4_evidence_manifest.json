    {
      "id": "3.9",
      "title": "Statistical methodology",
      "planned_later_prose_budget_words": 300,
      "bootstrap_configuration_by_family": [
        {
          "family": "v2_05c",
          "status": "CONFIRMED",
          "configuration": "Image-clustered percentile bootstrap; 2,000 draws from NumPy default_rng(0); clusters are each slice's represented development imageIds; 2.5th and 97.5th percentiles; multi-seed rows combine seeds by the within-draw mean.",
          "sources": [
            {
              "path": "results/experiments/v2_05_types/addendum_clustered.json",
              "location": "$.v2_05c_clustered_correction.method"
            }
          ]
        },
        {
          "family": "V3",
          "status": "CONFIRMED",
          "configuration": "Image-clustered paired bootstrap over represented development imageIds; 2,000 draws at RNG seed 0; paired quantities remain paired inside a draw.",
          "sources": [
            {
              "path": "results/experiments/v3_02a_refs/step_statistics.json",
              "location": "$.v3_02a_step_statistics.bootstrap and $.v3_02a_step_statistics.reasoner_minus_fusion_deficit_paired"
            },
            {
              "path": "results/experiments/v3_03_scaling/results.json",
              "location": "$.v3_03_scaling.bootstrap.*.reasoner_minus_fusion_deficit_paired"
            }
          ]
        },
        {
          "family": "E8A",
          "status": "CONFIRMED",
          "configuration": "Image-clustered paired percentile bootstrap; 2,000 draws from a fresh default_rng(0); represented development imageId clusters; seeds combined by the within-draw mean; 2.5th and 97.5th percentiles.",
          "sources": [
            {
              "path": "results/experiments/e8a_question_encoder/core_analysis_g21.json",
              "location": "$.e8a_core_analysis_g21.analyses.*.contrasts_normalized.*.{n_draws,rng_seed,n_clusters}"
            },
            {
              "path": "docs/experiments/e8a_core_135m.md",
              "location": "Uncertainty method, lines 57-62"
            }
          ]
        },
        {
          "family": "E8B",
          "status": "CONFIRMED",
          "configuration": "Image-clustered paired percentile bootstrap; 2,000 draws at seed 0; represented development imageId clusters; seeds combined by the within-draw mean.",
          "sources": [
            {
              "path": "results/experiments/e8b_readout_generation/e8b_core_analysis_20260809.json",
              "location": "$.e8b_core_analysis.paired_contrasts[*].bootstrap and .n_image_clusters"
            },
            {
              "path": "docs/experiments/e8b_core_matrix.md",
              "location": "Primary uncertainty method, lines 21-27"
            }
          ]
        },
        {
          "family": "E10",
          "status": "CONFIRMED",
          "configuration": "Image-clustered paired percentile bootstrap; 2,000 draws at seed 0 with alpha 0.05; clustering by development imageId; seeds combined through the pinned E8A analysis implementation.",
          "sources": [
            {
              "path": "results/experiments/e10_capacity_360m_core/e10_core_analysis.json",
              "location": "$.e10_core_analysis.contrasts.*.metrics.*.bootstrap"
            }
          ]
        }
      ],
      "supported_facts": [
        {
          "fact_id": "canonical_clustered_interval",
          "fact": "The canonical inferential interval resamples represented development imageIds because questions sharing an image are not independent rows. Paired contrasts resample both sides together within each draw.",
          "sources": [
            {
              "path": "results/experiments/v2_05_types/addendum_clustered.json",
              "location": "$.v2_05c_clustered_correction.method and $.v2_05c_clustered_correction.reason"
            },
            {
              "path": "results/closure/reconstructed_statistics.json",
              "location": "$.cluster_units and $.uncertainty_note"
            }
          ]
        },
        {
          "fact_id": "row_level_supersession",
          "fact": "The v2_05b row-level normal-approximation intervals are superseded for inference by v2_05c image-clustered intervals and are never re-quoted as inferential evidence.",
          "sources": [
            {
              "path": "docs/experiments/v2_05_types.md",
              "location": "Correction v2_05c, lines 145-158"
            },
            {
              "path": "results/closure/A_evidence_registry.json",
              "location": "$.registry[family=v2_05b] and $.registry[family=v2_05c]"
            }
          ]
        },
        {
          "fact_id": "seed_sd_separation",
          "fact": "The image-clustered interval is evaluation-sampling uncertainty conditioned on the fixed trained seed set. Across-seed variability is the sample standard deviation over independently trained seeds with ddof=1, reported separately and never as a confidence interval.",
          "sources": [
            {
              "path": "results/closure/reconstructed_statistics.json",
              "location": "$.uncertainty_note"
            }
          ]
        },
        {
          "fact_id": "directional_claim_rule",
          "fact": "For a paired contrast, positive directional evidence requires a positive mean, an interval lower bound above zero, and at least two of three seed differences above zero; negative directional evidence uses the mirrored conditions. Everything else is uncertain or mixed evidence.",
          "sources": [
            {
              "path": "docs/experiments/e8a_core_135m.md",
              "location": "Uncertainty method, lines 57-62"
            },
            {
              "path": "results/experiments/e8b_readout_generation/e8b_final_report_20260810.json",
              "location": "$.e8b_final_report.PRIMARY.paired_contrasts_in_vocabulary[*].directional_rule_outcome"
            },
            {
              "path": "results/experiments/e10_capacity_360m_core/e10_core_analysis.json",
              "location": "$.e10_core_analysis.contrasts.*.metrics.*.directional_rule"
            }
          ]
        },
        {
          "fact_id": "no_equivalence_from_zero_inclusion",
          "fact": "An interval including zero does not establish equivalence or the absence of an effect.",
          "sources": [
            {
              "path": "results/experiments/e10_capacity_360m_core/e10_core_execution_correction_20260813.json",
              "location": "$.e10_core_execution_correction.interpretation_narrowing.adopted_wording"
            }
          ]
        },
        {
          "fact_id": "multiplicity_disclosure",
          "fact": "Multiple comparisons exist. Every interval is nominal and uncorrected for multiplicity; no family-wise correction was applied and no adjusted procedure is introduced here.",
          "sources": [
            {
              "path": "results/closure/F_multiplicity_status.json",
              "location": "$.multiplicity_statement and $.no_fishing_statement"
            }
          ]
        },
        {
          "fact_id": "pooled_ge4_definition_only",
          "fact": "Combined four-or-more-step lift is the question-weighted pool of the 4-step and at-least-5-step bucket lifts under the fixed per-bucket prior. The pooled deficit is the mean of the four bucket lifts minus that combined lift. This single combined definition supersedes v3_01's unweighted mean of the two higher-step bucket lifts.",
          "sources": [
            {
              "path": "results/experiments/v3_02a_refs/step_statistics.json",
              "location": "$.v3_02a_step_statistics.definitions"
            },
            {
              "path": "docs/experiments/v3_02a_refs.md",
              "location": "Definition and supersession, lines 64-74"
            }
          ]
        },
        {
          "fact_id": "v2_07_inference_limit",
          "fact": "The v2_07 family has no image-clustered interval: row-level reconstruction stopped after one stored point estimate failed exact reproduction at the canonical precision. No row array or interval was created; stored per-seed aggregates and across-seed standard deviations remain verified only within their stated scope.",
          "sources": [
            {
              "path": "results/closure/C_reconstructed_evidence_manifest.json",
              "location": "$.blockers[family=v2_07] and $.reproduction_gate"
            },
            {
              "path": "results/closure/A_evidence_registry.json",
              "location": "$.registry[family=v2_07]"
            }
          ]
        }
      ],
