  "claim_mappings": [
    {"claim_id": "3.8.v2_recipe_and_scales", "sentence_scope": "The controlled global-head studies are defined as V2 at first use; their fixed 30-epoch recipe, five-seed train_40k scope and separately pinned 100k/250k scaling extension are recorded.", "fact_refs": ["S3:protocol_families"]},
    {"claim_id": "3.8.reasoner_recipe", "sentence_scope": "V3/E8A/B1 optimiser, precision, scale, seed, epoch and early-stopping protocol.", "fact_refs": ["S3:protocol_families", "S3:precision_rules"]},
    {"claim_id": "3.8.answer_side_recipe", "sentence_scope": "B2/B3/B4r/B4 fixed 22-epoch recipe, precision boundary and E10 cadence/no-resume controls.", "fact_refs": ["S3:protocol_families", "S3:precision_rules"]},
    {"claim_id": "3.8.selection", "sentence_scope": "Performance-based selection uses development only, with earliest ties; answer-side systems use a protocol-fixed epoch-22 checkpoint and retain the pre-existing default recipe independently of observed exploratory outcomes; the B1/B2/B3 selection-mismatch caveat remains.", "fact_refs": ["S3:checkpoint_selection_authority", "S3:precision_rules"], "sources": ["e8b_fixed22", "e8b_superseded"]},
    {"claim_id": "3.9.seed_variability", "sentence_scope": "Predefined five- and three-seed scopes; mean and sample SD with ddof=1 as between-training-run variability.", "fact_refs": ["S4:seed_sd_separation"]},
    {"claim_id": "3.9.clustered_bootstrap", "sentence_scope": "Image as cluster; 2,000 paired draws using default_rng(0); within-draw seed mean; 2.5/97.5 percentiles; conditional evaluation-sampling interpretation.", "fact_refs": ["S4:canonical_clustered_interval", "S4:row_level_supersession", "S4:seed_sd_separation"]},
    {"claim_id": "3.9.directional_rule", "sentence_scope": "Exact positive/mirrored-negative/uncertain-or-mixed rule, scoped only to the canonically governed three-seed E8A/E8B/E10 paired contrasts.", "fact_refs": ["S4:directional_claim_rule"]},
    {"claim_id": "3.9.caveats", "sentence_scope": "Zero-containing intervals do not establish equivalence or absence; nominal intervals are uncorrected for multiplicity.", "fact_refs": ["S4:no_equivalence_from_zero_inclusion", "S4:multiplicity_disclosure"]},
    {"claim_id": "3.9.pooled_deficit", "sentence_scope": "Four step buckets use fixed per-bucket question priors; combined_ge4 pools only the four-step and five-or-more-step buckets weighted by those priors; the pooled deficit is the unweighted mean of all four bucket lifts minus combined_ge4; all outcome values and prior constants remain omitted.", "fact_refs": ["S4:pooled_ge4_definition_only"], "sources": ["step_statistics"]},
    {"claim_id": "3.9.v2_limit", "sentence_scope": "V2 scaling inference limited to canonical per-seed aggregates and seed variability because no valid reconstructed clustered interval exists.", "fact_refs": ["S4:v2_07_inference_limit"]},
    {"claim_id": "3.10.initial_interventions", "sentence_scope": "Normal, row-shuffled and zeroed inputs, seed 42, unchanged questions, question-only control and the zeroed fusion form.", "fact_refs": ["S4:wrong_image_matched_logic", "S4:row_shuffle_supersession_reason"]},
    {"claim_id": "3.10.derangement", "sentence_scope": "No-fixed-point imageId derangement, one partner per image, 11/0.14 per cent supersession fact and E9 partner-mapping scope.", "fact_refs": ["S4:canonical_imageid_derangement", "S4:row_shuffle_supersession_reason", "S4:e9_matched_partner_scope"]},
