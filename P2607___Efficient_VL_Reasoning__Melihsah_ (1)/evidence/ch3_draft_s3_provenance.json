    {"claim_id": "3.11.e7b", "sentence_scope": "Authoritative serial batch-1 protocol, pass/subprocess/warm-up/timed-query constants, warm median, synchronisation and otter155 hardware.", "fact_refs": ["S4:e7b_serial_protocol"]},
