# Virtual environment and redirected caches
.venv/
.cache/

# Large data and generated artefacts. The directories themselves are kept in
# the repository through their .gitkeep files; only their contents are ignored,
# because the stage scripts regenerate everything here.
data/*
!data/.gitkeep
embeddings/*
!embeddings/.gitkeep
results/*
!results/.gitkeep
# The cross-E8 ceiling supersession record is programme-wide
# governance, not an experiment output, so it lives at the results
# root and is tracked. Every gate and doc references it by path.
!results/cross_e8_ceiling_supersession_*.json

# E8A SmolLM2-135M core: the small auditable JSON records are tracked so every
# reported number can be checked from a clone. The binaries are not: see
# results/experiments/e8a_question_encoder/README.md and ARTEFACT_MANIFEST.json.
# Each directory level has to be re-included before git will descend into it.
!results/experiments/
results/experiments/*
!results/experiments/e8a_question_encoder/
results/experiments/e8a_question_encoder/*
!results/experiments/e8a_question_encoder/*.json
!results/experiments/e8a_question_encoder/README.md
# G21 per-row prediction artefacts: the JSON sidecars and summary are small
# and tracked; the per-row csv.gz tables are manifested binaries.
!results/experiments/e8a_question_encoder/predictions_g21_v1/
results/experiments/e8a_question_encoder/predictions_g21_v1/*
!results/experiments/e8a_question_encoder/predictions_g21_v1/*.json
# E7b serial-efficiency records: all artefacts are small JSON/CSV/PNG and
# tracked in full; there are no omitted binaries.
!results/experiments/e7b_serial_efficiency/
results/experiments/e7b_serial_efficiency/*
!results/experiments/e7b_serial_efficiency/*.json
!results/experiments/e7b_serial_efficiency/*.csv
!results/experiments/e7b_serial_efficiency/*.png
!results/experiments/e7b_serial_efficiency/*.txt
!results/experiments/e7b_serial_efficiency/pilot_evidence/
results/experiments/e7b_serial_efficiency/pilot_evidence/*
!results/experiments/e7b_serial_efficiency/pilot_evidence/*.json

# E8B readout-generation records: preregistration, preflight and audit
# JSON records are tracked; checkpoints and large artefacts stay ignored.
# The rendered analysis tables and figures are tracked too, on the same
# footing as E7b's csv and png: they are small, they are named as Outputs in
# docs/experiments/e8b_core_matrix.md, and a clone could not otherwise see
# an artefact the report cites. The 37 per-row npz arrays, the checkpoints,
# the failed-attempt archive and the run logs stay ignored.
!results/experiments/e8b_readout_generation/
results/experiments/e8b_readout_generation/*
!results/experiments/e8b_readout_generation/*.json
!results/experiments/e8b_readout_generation/*.md
!results/experiments/e8b_readout_generation/*.png

# E9 compact-VLM records: the same policy as E8A and E8B. Small auditable
# JSON and markdown are tracked so every reported number can be checked from
# a clone; the per-row token npz arrays stay local and are covered by
# results/experiments/e9_compact_vlm/ARTEFACT_MANIFEST.json, which records
# each one's path, size and SHA-256. E9 writes no checkpoint.
!results/experiments/e9_compact_vlm/
results/experiments/e9_compact_vlm/*
!results/experiments/e9_compact_vlm/*.json
!results/experiments/e9_compact_vlm/*.md
!results/experiments/e9_compact_vlm/timing/
results/experiments/e9_compact_vlm/timing/*
!results/experiments/e9_compact_vlm/timing/*.json

# E10 360M Phase-0 records: only small auditable JSON governance,
# provenance, calibration and Gate-1 records are tracked. Model weights stay
# in the project cache, and checkpoints/arrays/logs remain ignored.
!results/experiments/e10_capacity_360m/
results/experiments/e10_capacity_360m/*
!results/experiments/e10_capacity_360m/*.json

# E10 360M scientific cells: the same policy as E8B. The per-cell JSON records
# and the matrix analysis are tracked so every reported number can be checked
# from a clone; the checkpoints and the per-row npz arrays stay local and are
# tracked by the SHA-256 recorded inside each cell record. This tree is
# deliberately separate from the Phase-0/Phase-1 governance tree above.
!results/experiments/e10_capacity_360m_core/
results/experiments/e10_capacity_360m_core/*
!results/experiments/e10_capacity_360m_core/*.json
!results/experiments/e10_capacity_360m_core/*.md

# Post-experiment statistical and efficiency closure: the same policy again.
# The registry, contrast, slice, seed, multiplicity, claim, readiness and
# efficiency tables are small and auditable, so they are tracked and a clone
# can check every closure number. The reconstructed per-row npz arrays under
# row_evidence/ are binaries and stay local; each one's path, size and
# SHA-256 is recorded in C_reconstructed_evidence_manifest.json.
!results/closure/
results/closure/*
!results/closure/*.json
!results/closure/*.csv
!results/closure/*.md

# Python bytecode
__pycache__/
*.pyc

# Editor and OS files
.vscode/
.DS_Store

# Logs
*.log

# Claude Code host-specific settings remain local. The two project agents are
# tracked so every clone has the same read-only planner and reviewer roles.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/research-planner.md
!.claude/agents/research-reviewer.md

# Runtime Claude-Codex packets can contain machine paths and large diffs. The
# protocol and templates are tracked under collab/; task instances stay local.
.agent-bridge/
